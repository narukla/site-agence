---
// Page Merci — responsable : Jimmy
// Affichée après l'envoi du formulaire de contact (action="/merci" dans contact.astro).
import Layout from '../layouts/Layout.astro';
---

<Layout title="Message envoyé" description="Votre message a bien été envoyé à Narukla." noindex>
	<section class="merci aplat" aria-labelledby="titre-merci">
		<h1 id="titre-merci">Merci, votre message est bien parti</h1>
		<p>On revient vers vous sous 48 h.</p>
		<p><a class="bouton bouton--principal" href="/">Retour à l'accueil</a></p>
	</section>
</Layout>

<style>
	/* Direction visuelle provisoire (mar. 27), à retoucher par Noah et Lucas */
	.merci {
		padding-block: var(--espace-section);
	}

	.merci h1 {
		max-width: 14ch;
	}

	.merci p {
		font-size: 1.1875rem;
	}

	.merci .bouton {
		margin-top: 1rem;
	}
</style>
