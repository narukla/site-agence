	<section class="merci" aria-labelledby="titre-merci">
		<h1 id="titre-merci">Merci, votre message est bien parti</h1>
		<p>On revient vers vous sous 48 h.</p>
		<p><a href="/">Retour à l'accueil</a></p>
	</section>
</Layout>
