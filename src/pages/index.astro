---
// Page Accueil — responsable : Jimmy
// Direction visuelle provisoire (mar. 27) tirée du Figma, à retoucher par Noah et Lucas.
// Prix et étapes repris de la page Services et tarifs : les garder identiques si l'une change.
import Layout from '../layouts/Layout.astro';

const offres = [
	{
		titre: 'Site vitrine',
		texte:
			'Un site clair, rapide et adapté au mobile pour présenter votre activité, vos horaires et vos coordonnées.',
		prix: '800 €',
		ancre: '/services#site-vitrine',
	},
	{
		titre: 'Identité visuelle',
		texte:
			'Logo, couleurs et typographies : une image cohérente sur votre vitrine, vos réseaux et vos supports.',
		prix: 'De 600 à 1 000 €',
		ancre: '/services#identite-visuelle',
	},
	{
		titre: 'Maintenance',
		texte:
			'On garde votre site à jour et sauvegardé, et on modifie vos horaires ou vos prix quand vous en avez besoin.',
		prix: '40 €/mois',
		ancre: '/services#maintenance',
	},
];

const etapes = [
	{
		titre: 'On discute de votre projet',
		texte: 'Un premier rendez-vous pour comprendre votre activité et vos besoins, puis un devis clair.',
	},
	{
		titre: 'On crée votre maquette',
		texte: 'Après un acompte de 30\u00a0%, on conçoit la maquette de votre site.',
	},
	{
		titre: 'On ajuste ensemble',
		texte: 'Trois tours de modifications sont inclus pour que le résultat vous ressemble.',
	},
	{
		titre: 'On met en ligne',
		texte:
			"Nom de domaine en .fr et hébergement compris la première année : vous n'avez rien à gérer.",
	},
];
---

<Layout
	title="Accueil"
	description="Narukla, agence web à Troyes : sites vitrines, identités visuelles et maintenance pour les commerces, artisans et indépendants."
>
	<section class="accueil__hero aplat" aria-labelledby="titre-accueil">
		<p class="bandeau bandeau--blanc">Agence web · Troyes</p>
		<h1 id="titre-accueil">
			Votre site web, pensé pour vos clients et livré <span class="accueil__surligne">sans prise de tête</span>
		</h1>
		<!-- Décision de Jimmy (27/10) : le statut d'étudiants est dit sur L'équipe, pas ici -->
		<p class="accueil__accroche">
			Narukla est une agence web installée à Troyes. Nous créons des sites vitrines et des identités
			visuelles pour les commerces, artisans et indépendants qui veulent être trouvés en ligne.
		</p>
		<ul class="accueil__actions">
			<li><a class="bouton bouton--principal" href="/contact">Demander un devis</a></li>
			<li><a class="bouton" href="/services">Voir nos offres</a></li>
		</ul>
		<!-- Logo en grand, décoratif (déjà annoncé par l'en-tête) -->
		<img
			class="accueil__logo"
			src="/images/logo-narukla-blanc.webp"
			alt=""
			width="720"
			height="273"
		/>
	</section>

	<section class="accueil__offres" aria-labelledby="titre-offres">
		<h2 id="titre-offres">Ce qu'on fait pour vous</h2>
		<ol class="accueil__liste-offres">
			{
				offres.map((offre) => (
					<li class="accueil__offre">
						<h3 class="accueil__offre-titre">{offre.titre}</h3>
						<p class="accueil__offre-texte">{offre.texte}</p>
						<p class="accueil__offre-prix">{offre.prix}</p>
						<a class="accueil__offre-lien" href={offre.ancre}>
							En savoir plus<span class="visuellement-cache"> sur l'offre {offre.titre.toLowerCase()}</span>
						</a>
					</li>
				))
			}
		</ol>
	</section>

	<section class="accueil__etapes aplat" aria-labelledby="titre-etapes">
		<h2 id="titre-etapes">Comment ça se passe</h2>
		<ol class="accueil__liste-etapes">
			{
				etapes.map((etape) => (
					<li class="accueil__etape">
						<h3 class="accueil__etape-titre">{etape.titre}</h3>
						<p class="accueil__etape-texte">{etape.texte}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="accueil__pourquoi" aria-labelledby="titre-pourquoi">
		<h2 id="titre-pourquoi">Pourquoi nous choisir</h2>
		<div class="accueil__pourquoi-contenu">
			<ul class="accueil__liste-pourquoi">
				<li class="accueil__argument">
					<h3>Des prix pensés pour les petites structures</h3>
					<p>Des tarifs fixes, annoncés à l'avance, sans mauvaise surprise.</p>
				</li>
				<li class="accueil__argument">
					<h3>Une équipe complète</h3>
					<p>
						Développement, graphisme et marketing : cinq associés qui suivent votre projet du premier
						rendez-vous à la mise en ligne.
					</p>
				</li>
				<li class="accueil__argument">
					<h3>Des interlocuteurs proches</h3>
					<p>On est à Troyes : on peut se rencontrer et on vous répond vite.</p>
				</li>
			</ul>
			<p><a class="accueil__lien-equipe" href="/equipe">Découvrir l'équipe</a></p>
		</div>
	</section>

	<section class="accueil__contact aplat" aria-labelledby="titre-contact">
		<h2 id="titre-contact">Un projet en tête ?</h2>
		<p>Parlez-nous de votre activité, on vous répond sous 48 h.</p>
		<p><a class="bouton" href="/contact">Contactez-nous</a></p>
	</section>
</Layout>

<style>
	/* Direction visuelle provisoire (mar. 27), à retoucher par Noah et Lucas */
	section {
		padding-block: var(--espace-section);
	}

	ul,
	ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Hero : bande noire collée à l'en-tête, texte calé à gauche */
	.accueil__hero {
		padding-top: clamp(2.5rem, 2rem + 4vw, 5rem);
	}

	.accueil__hero {
		position: relative;
	}

	.accueil__hero h1 {
		max-width: 14ch;
		margin-top: 1.5rem;
		line-height: 1.02;
	}

	.accueil__logo {
		display: none;
	}

	.accueil__surligne {
		color: var(--couleur-violet);
	}

	.accueil__accroche {
		max-width: 34rem;
		margin-bottom: 2.5rem;
		font-size: 1.1875rem;
	}

	.accueil__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	/* Offres : lignes séparées par des traits, numéros, prix en gros */
	.accueil__liste-offres {
		counter-reset: offre;
		border-bottom: var(--trait) solid var(--couleur-noir);
	}

	.accueil__offre {
		counter-increment: offre;
		display: grid;
		gap: 0.5rem 2rem;
		padding-block: 2rem;
		border-top: var(--trait) solid var(--couleur-noir);
	}

	.accueil__offre::before {
		content: counter(offre, decimal-leading-zero);
		font-family: var(--police-titre);
		font-size: 1.25rem;
		color: var(--couleur-violet);
	}

	.accueil__offre-titre {
		margin: 0;
		font-size: var(--taille-h3);
	}

	.accueil__offre-texte {
		margin: 0;
		max-width: 28rem;
	}

	.accueil__offre-prix {
		margin: 0;
		font-family: var(--police-titre);
		font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
		line-height: 1;
		white-space: nowrap;
	}

	@media (min-width: 48rem) {
		.accueil__offre-prix {
			text-align: right;
		}
	}

	.accueil__offre-lien {
		font-weight: 800;
	}

	/* Étapes : bande bleue, gros numéros en contour comme les lettres du logo */
	.accueil__etapes {
		--aplat: var(--couleur-bleu);
	}

	.accueil__liste-etapes {
		display: grid;
		gap: 2.5rem 2rem;
		counter-reset: etape;
	}

	.accueil__etape {
		counter-increment: etape;
		padding-top: 1rem;
		border-top: var(--trait) solid var(--couleur-blanc);
	}

	.accueil__etape::before {
		content: counter(etape, decimal-leading-zero);
		display: block;
		margin-bottom: 0.75rem;
		font-family: var(--police-titre);
		font-size: 4.5rem;
		line-height: 1;
		color: transparent;
		-webkit-text-stroke: 2px var(--couleur-blanc);
	}

	.accueil__etape-texte {
		margin: 0;
	}

	/* Pourquoi : titre à gauche, arguments à droite */
	.accueil__argument {
		padding-block: 1.25rem;
		border-bottom: var(--trait) solid var(--couleur-noir);
	}

	.accueil__argument:first-child {
		padding-top: 0;
	}

	.accueil__argument h3::before {
		content: '';
		display: inline-block;
		width: 0.6em;
		height: 0.6em;
		margin-right: 0.5rem;
		background: var(--couleur-violet);
		vertical-align: 0.05em;
	}

	.accueil__argument p {
		margin: 0;
	}

	.accueil__pourquoi-contenu > p {
		margin-top: 1.5rem;
	}

	.accueil__lien-equipe {
		font-weight: 800;
	}

	/* Appel à l'action : bande violette */
	.accueil__contact {
		--aplat: var(--couleur-violet);
	}

	.accueil__contact h2 {
		font-size: var(--taille-h1);
	}

	.accueil__contact p {
		font-size: 1.1875rem;
	}

	.accueil__contact .bouton {
		margin-top: 1rem;
	}

	@media (min-width: 48rem) {
		.accueil__offre {
			grid-template-columns: 3rem 1fr 1.4fr 13rem;
			align-items: baseline;
		}

		.accueil__offre-lien {
			grid-column: 2 / -1;
		}

		.accueil__liste-etapes {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.accueil__liste-etapes {
			grid-template-columns: repeat(4, 1fr);
		}

		.accueil__logo {
			display: block;
			position: absolute;
			right: 0;
			top: 50%;
			width: 32%;
			transform: translateY(-50%) rotate(-4deg);
		}

		.accueil__hero h1,
		.accueil__accroche {
			max-width: 62%;
		}

		.accueil__pourquoi {
			display: grid;
			grid-template-columns: 1fr 1.3fr;
			gap: 4rem;
			align-items: start;
		}
	}
</style>
