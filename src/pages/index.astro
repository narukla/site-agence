---
// Page Accueil — responsable : Jimmy
// Mise en page d'après la maquette Figma de Noah (Accueil desktop 1440 et mobile 390), contenu inchangé.
// Étapes reprises de la page Services et tarifs : les garder identiques si l'une change.
// Pas de prix sur l'Accueil (demande de Jibril, 5/11) : le visiteur découvre l'offre avant le tarif, les prix sont sur Services.
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
import Bouton from '../components/Bouton.astro';

const offres = [
	{
		titre: 'Site vitrine',
		texte:
			'Un site clair, rapide et adapté au mobile pour présenter votre activité, vos horaires et vos coordonnées.',
		ancre: '/services#site-vitrine',
	},
	{
		titre: 'Identité visuelle',
		texte:
			'Logo, couleurs et typographies : une image cohérente sur votre vitrine, vos réseaux et vos supports.',
		ancre: '/services#identite-visuelle',
	},
	{
		titre: 'Maintenance',
		texte:
			'On garde votre site à jour et sauvegardé, et on modifie vos horaires ou vos prix quand vous en avez besoin.',
		ancre: '/services#maintenance',
	},
];

const etapes = [
	{
		titre: 'On discute de votre projet',
		texte: 'Un premier rendez-vous pour comprendre votre activité et vos besoins, puis un devis clair.',
	},
	{
		titre: 'On crée votre maquette',
		texte: 'Après un acompte de 30 %, on conçoit la maquette de votre site.',
	},
	{
		titre: 'On ajuste ensemble',
		texte: 'Trois tours de modifications sont inclus (selon conditions) pour que le résultat vous ressemble.',
	},
	{
		titre: 'On met en ligne',
		texte:
			"Nom de domaine en .fr et hébergement compris la première année, puis compris dans la maintenance : vous n'avez rien à gérer.",
	},
];

// Numéro sur deux chiffres : 1 → « 01 »
const numero = (i: number) => String(i + 1).padStart(2, '0');
---

<Layout
	title="Agence web à Troyes : création de site vitrine"
	description="Narukla, agence web à Troyes : sites vitrines, identités visuelles et maintenance pour les commerces, artisans et indépendants."
>
	<Intro etiquette="Agence web · Troyes" titre="Votre site web, pensé pour vos clients et livré" accent="sans prise de tête">
		<!-- Décision de Jimmy (27/10) : le statut d'étudiants est dit sur L'équipe, pas ici -->
		<p>
			Narukla est une agence web installée à Troyes. Nous créons des sites vitrines et des identités
			visuelles pour les commerces, artisans et indépendants qui veulent être trouvés en ligne.
		</p>
		<ul class="accueil__actions">
			<li><Bouton href="/contact">Demander un devis</Bouton></li>
			<li><Bouton href="/services" variante="contour">Voir nos offres</Bouton></li>
		</ul>
	</Intro>

	<!-- Effet du labo « bandeau qui défile » (Texte 01) : décoratif, le lecteur d'écran lit le résumé -->
	<div class="accueil__bandeau-cadre">
		<div class="accueil__bandeau" role="img" aria-label="Sites vitrines, identités visuelles, maintenance, à Troyes">
			<div class="accueil__bandeau-piste" aria-hidden="true">
				<div class="accueil__bandeau-groupe"><span>Sites vitrines</span><span>Identités visuelles</span><span>Maintenance</span><span>Troyes</span></div>
				<div class="accueil__bandeau-groupe"><span>Sites vitrines</span><span>Identités visuelles</span><span>Maintenance</span><span>Troyes</span></div>
			</div>
		</div>
	</div>

	<section class="accueil__offres" aria-labelledby="titre-offres">
		<h2 id="titre-offres" class="accueil__titre-section">Ce qu'on fait pour vous :</h2>
		<ul class="accueil__liste-offres">
			{
				offres.map((offre, i) => (
					<li>
						<article class="accueil__offre">
							<span class="accueil__offre-numero" aria-hidden="true">
								{numero(i)}
							</span>
							<h3 class="accueil__offre-titre">{offre.titre}</h3>
							<p class="accueil__offre-texte">{offre.texte}</p>
							<a class="accueil__lien accueil__offre-lien" href={offre.ancre}>
								En savoir plus<span class="accueil__cache"> sur l'offre {offre.titre.toLowerCase()}</span>
								<span class="accueil__fleche" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12h14m-6-6 6 6-6 6" /></svg></span>
							</a>
						</article>
					</li>
				))
			}
		</ul>
	</section>

	<section class="accueil__etapes accueil__bande accueil__bande--violet" aria-labelledby="titre-etapes">
		<h2 id="titre-etapes" class="accueil__titre-section">Comment ça se passe ?</h2>
		<ol class="accueil__liste-etapes">
			{
				etapes.map((etape, i) => (
					<li class="accueil__etape" style={`--i: ${i}`}>
						<span class="accueil__etape-numero" aria-hidden="true">
							{numero(i)}
						</span>
						<h3 class="accueil__etape-titre">{etape.titre}</h3>
						<p class="accueil__etape-texte">{etape.texte}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="accueil__pourquoi" aria-labelledby="titre-pourquoi">
		<h2 id="titre-pourquoi" class="accueil__titre-section">Pourquoi nous choisir ?</h2>
		<div class="accueil__pourquoi-droite">
			<ul class="accueil__liste-pourquoi">
				<li class="accueil__argument">
					<h3>Des prix pensés pour les petites structures</h3>
					<p>Des tarifs clairs, annoncés à l'avance, sans mauvaise surprise.</p>
				</li>
				<li class="accueil__argument">
					<h3>Une équipe complète</h3>
					<p>
						Développement, graphisme et marketing : quatre associés qui suivent votre projet du premier
						rendez-vous à la mise en ligne.
					</p>
				</li>
				<li class="accueil__argument">
					<h3>Des interlocuteurs proches</h3>
					<p>On est à Troyes : on peut se rencontrer et on vous répond vite.</p>
				</li>
			</ul>
			<p><a class="accueil__lien" href="/equipe">Découvrir l'équipe <span class="accueil__fleche" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12h14m-6-6 6 6-6 6" /></svg></span></a></p>
		</div>
	</section>

	<section class="accueil__contact accueil__bande accueil__bande--violet" aria-labelledby="titre-contact">
		<h2 id="titre-contact" class="accueil__titre-grand">Un projet en tête ?</h2>
		<!-- La maquette dit « sous 48 h » : sondage du 29/10, question 1 → « sous 2 jours ouvrés » -->
		<p class="accueil__texte-large">Parlez-nous de votre activité, on vous répond sous 2 jours ouvrés.</p>
		<a class="accueil__bouton-blanc" href="/contact">Contactez-nous</a>
	</section>
</Layout>

<style>
	/* Mise en page d'après la maquette Figma de Noah (Accueil), mobile d'abord.
	   Bandes pleine largeur avec border-image (même technique que L'équipe et Intro.astro). */
	/* 4,25rem comme les bandes de Services et L'équipe (audit de cohérence du 2/11) */
	.accueil__bande {
		padding-block: 4.25rem;
		border-image: conic-gradient(var(--fond-bande) 0 0) fill 0 / / 0 100vw;
	}

	/* Blanc sur violet : contraste 6,33 */
	.accueil__bande--violet {
		--fond-bande: var(--couleur-violet);
		color: var(--couleur-blanc);
	}

	.accueil__titre-section,
	.accueil__titre-grand {
		margin: 0;
		font-family: var(--police-titre);
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 400;
		line-height: 0.95;
		text-transform: uppercase;
	}

	.accueil__titre-grand {
		font-size: clamp(3.125rem, 7.8vw, 7rem);
	}

	.accueil__lien {
		font-family: var(--police-corps);
		font-size: 1.0625rem;
		font-weight: 800;
		color: inherit;
	}

	/* Texte lu par les lecteurs d'écran seulement (le lien dit de quelle offre il s'agit) */
	.accueil__cache {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Bandeau d'ouverture : les deux boutons sous le texte (maquette mobile et code de Jimmy) */
	.accueil__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}

	/* Sur le fond noir du bandeau : pas de bordure noire (invisible), ombre blanche derrière le bouton violet et
	   violette derrière le bouton blanc (commentaires de Noah, 01/11), qui s'enfonce au survol comme les autres boutons */
	.accueil__actions :global(.bouton) {
		border-color: transparent;
		box-shadow: 6px 6px 0 var(--couleur-blanc);
	}

	.accueil__actions :global(.bouton--contour) {
		box-shadow: 6px 6px 0 var(--couleur-violet);
	}

	.accueil__actions :global(.bouton:hover) {
		box-shadow: 3px 3px 0 var(--couleur-blanc);
	}

	.accueil__actions :global(.bouton--contour:hover) {
		box-shadow: 3px 3px 0 var(--couleur-violet);
	}

	.accueil__actions :global(.bouton:focus-visible) {
		outline-color: var(--couleur-blanc);
	}

	/* Bandeau qui défile : penché, violet, pleine largeur.
	   Le cadre fait toute la largeur de l'écran (100vw, barre de défilement comprise) et coupe ce qui dépasse
	   (le bandeau penché) ; overflow-x: clip sur html retire les quelques pixels de la barre de défilement
	   de Windows, sans casser position: sticky. */
	:global(html) {
		overflow-x: clip;
	}

	/* Sur html, « clip » devient « hidden » pour la fenêtre : la souris ne fait plus défiler de côté, mais un script,
	   une ancre ou la touche Tab le pouvaient encore (page décalée, mesuré le 4/11 : 200 px possibles, piste des étapes
	   large de 2 696 px). Sur body, clip coupe vraiment ce qui dépasse, sans créer de zone de défilement : le bandeau
	   et l'épinglage des étapes (position sticky / GSAP) marchent toujours. */
	:global(body) {
		overflow-x: clip;
	}

	.accueil__bandeau-cadre {
		margin-inline: calc(50% - 50vw);
		margin-block: -1.5rem 0;
		padding-block: 1rem;
		overflow: clip;
		/* Noir au-dessus, blanc en dessous : pas de coin blanc entre le bandeau penché et la bande noire */
		background: linear-gradient(var(--couleur-noir) 50%, var(--couleur-blanc) 50%);
	}

	.accueil__bandeau {
		margin-inline: -2rem;
		overflow: hidden;
		background: var(--couleur-violet);
		color: var(--couleur-blanc);
		border-block: 3px solid var(--couleur-noir);
		transform: rotate(-1.5deg);
	}

	.accueil__bandeau-piste {
		display: flex;
		width: max-content;
	}

	.accueil__bandeau-groupe {
		display: flex;
		flex-shrink: 0;
	}

	.accueil__bandeau-groupe span {
		padding: 0.9rem 1.25rem 0.75rem;
		font-family: var(--police-titre);
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		line-height: 1;
		text-transform: uppercase;
		white-space: nowrap;
	}

	/* Séparateur décoratif entre les mots : un losange noir dessiné en CSS (pas de caractère spécial,
	   absent de la police Anton) */
	.accueil__bandeau-groupe span::after {
		content: '';
		display: inline-block;
		width: 0.45em;
		height: 0.45em;
		margin-left: 2.5rem;
		vertical-align: 0.2em;
		background: var(--couleur-noir);
		transform: rotate(45deg);
	}

	@media (prefers-reduced-motion: no-preference) {
		.accueil__bandeau-piste {
			animation: accueil-defile 18s linear infinite;
		}

		.accueil__bandeau:hover .accueil__bandeau-piste {
			animation-play-state: paused;
		}

		@keyframes accueil-defile {
			to {
				transform: translateX(-50%);
			}
		}
	}

	/* Ce qu'on fait pour vous : lignes séparées par des traits noirs */
	.accueil__offres {
		padding-block: 4rem;
	}

	.accueil__liste-offres {
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
		border-bottom: 3px solid var(--couleur-noir);
	}

	.accueil__offre {
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.5rem;
		padding-block: 1.75rem;
		border-top: 3px solid var(--couleur-noir);
		font-family: var(--police-corps);
	}

	/* Gros chiffres demandés par Noah (commentaire Figma), décoratifs : cachés aux lecteurs d'écran */
	.accueil__offre-numero {
		font-family: var(--police-titre);
		font-size: 4.5rem;
		line-height: 1;
		color: var(--couleur-violet);
	}

	.accueil__offre-titre {
		margin: 0;
		font-family: var(--police-titre);
		font-weight: 400;
		line-height: 1.05;
		text-transform: uppercase;
	}

	.accueil__offre-titre {
		font-size: 2.25rem;
	}

	.accueil__offre-texte {
		max-width: 28rem;
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.6;
	}

	.accueil__offre-lien {
		justify-self: start;
		padding-block: 0.6rem;
		font-size: 1.125rem;
	}

	/* Toute la ligne de l'offre est cliquable, pas seulement « En savoir plus » (commentaire de Noah, 01/11) */
	.accueil__offre-lien::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	/* Comment ça se passe : 4 cadres à bordure blanche.
	   Effet du labo « cartes qui s'empilent » (Défilement 05) : en descendant, chaque cadre se colle en haut
	   de l'écran (position: sticky), un peu plus bas que le précédent, et le suivant vient se poser dessus.
	   Sans JavaScript ; une seule colonne pour que l'empilement se voie. */
	.accueil__liste-etapes {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
		margin: 2.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.accueil__etape {
		position: sticky;
		top: calc(1rem + var(--i) * 1.75rem);
		padding: 1.5rem 1.75rem 2rem;
		background: var(--couleur-violet);
		border: 5px solid var(--couleur-blanc);
		box-shadow: 6px 6px 0 var(--couleur-noir);
		font-family: var(--police-corps);
	}

	/* Numéro en contour blanc, comme les initiales de L'équipe (décoratif : la liste est déjà numérotée) */
	.accueil__etape-numero {
		display: block;
		font-family: var(--police-titre);
		font-size: 4.5rem;
		line-height: 1;
		color: transparent;
		-webkit-text-stroke: 2px var(--couleur-blanc);
	}

	.accueil__etape-titre {
		margin: 1rem 0 0;
		font-family: var(--police-titre);
		font-size: 1.75rem;
		font-weight: 400;
		line-height: 1.05;
		text-transform: uppercase;
	}

	.accueil__etape-texte {
		margin: 0.75rem 0 0;
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	/* Pourquoi nous choisir : titre à gauche, arguments à droite (desktop) */
	.accueil__pourquoi {
		display: grid;
		gap: 2rem;
		padding-block: 4rem;
		font-family: var(--police-corps);
	}

	.accueil__liste-pourquoi {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.accueil__argument {
		padding-block: 1.25rem;
		border-bottom: 3px solid var(--couleur-noir);
	}

	.accueil__argument:first-child {
		padding-top: 0;
	}

	.accueil__argument h3 {
		margin: 0;
		font-family: var(--police-titre);
		font-size: 1.75rem;
		font-weight: 400;
		line-height: 1.05;
		text-transform: uppercase;
	}

	.accueil__argument p {
		margin: 0.5rem 0 0;
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	.accueil__pourquoi-droite > p {
		margin: 1.5rem 0 0;
	}

	.accueil__pourquoi-droite .accueil__lien {
		padding-block: 0.6rem;
	}

	/* Un projet en tête ? */
	.accueil__texte-large {
		max-width: 40rem;
		margin: 1rem 0 0;
		font-family: var(--police-corps);
		font-size: 1.1875rem;
		line-height: 1.6;
	}

	/* Bouton blanc sur la bande violette (même style que L'équipe) */
	.accueil__bouton-blanc {
		display: inline-block;
		margin-top: 1.5rem;
		background: var(--couleur-blanc);
		color: var(--couleur-noir);
		border: 3px solid var(--couleur-blanc);
		box-shadow: 6px 6px 0 var(--couleur-noir);
		font-family: var(--police-titre);
		text-transform: uppercase;
		text-decoration: none;
	}

	.accueil__bouton-blanc:hover {
		box-shadow: 3px 3px 0 var(--couleur-noir);
		transform: translate(3px, 3px);
	}

	@media (prefers-reduced-motion: no-preference) {
		.accueil__bouton-blanc {
			transition:
				transform 0.15s ease,
				box-shadow 0.15s ease;
		}
	}

	/* ───── Effets du labo d'effets (essai du 31/10) ───── */

	/* 1. Flèche qui avance (Survol 05) : la case violette glisse vers la droite au survol */
	.accueil__lien {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
	}

	.accueil__fleche {
		display: inline-grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		background: var(--couleur-violet);
		border: 2px solid var(--couleur-noir);
	}

	.accueil__fleche svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: var(--couleur-blanc);
		stroke-width: 2.5;
	}

	.accueil__lien:hover .accueil__fleche,
	.accueil__lien:focus-visible .accueil__fleche {
		transform: translateX(0.4rem);
	}

	/* 2. Survol d'une ligne d'offre : le numéro glisse */
	.accueil__offre-numero {
		transition: none;
	}

	.accueil__offre:hover .accueil__offre-numero,
	.accueil__offre:focus-within .accueil__offre-numero {
		transform: translateX(0.5rem);
	}


	@media (prefers-reduced-motion: no-preference) {
		.accueil__fleche {
			transition: transform 0.25s cubic-bezier(0.3, 1.5, 0.5, 1);
		}

		.accueil__offre-numero {
			transition: transform 0.25s ease;
		}

	}

	/* 3. Apparition au défilement (Défilement CSS 02) : les lignes montent en arrivant à l'écran.
	   Seulement si le navigateur sait faire (Chrome, Edge, Safari) ; ailleurs elles sont simplement là. */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.accueil__offre,
			.accueil__argument {
				animation: accueil-apparait linear both;
				animation-timeline: view();
				animation-range: entry 0% cover 30%;
			}

			@keyframes accueil-apparait {
				from {
					opacity: 0;
					transform: translateY(2.5rem);
				}
			}
		}
	}

	/* Focus clavier visible, de la couleur du texte (lisible sur chaque fond) */
	a:focus-visible {
		outline: 3px solid currentColor;
		outline-offset: 3px;
	}

	/* Desktop : offres sur une ligne (numéro, titre, texte), 4 étapes, Pourquoi en 2 colonnes */
	@media (min-width: 64rem) {
		.accueil__bande,
		.accueil__offres,
		.accueil__pourquoi {
			padding-block: 7.5rem;
		}

		.accueil__offre {
			grid-template-columns: 8rem 15rem minmax(0, 1fr);
			column-gap: 2rem;
			align-items: baseline;
		}

		.accueil__offre-numero {
			grid-row: 1 / span 2;
			align-self: center;
			font-size: 7.5rem;
		}

		.accueil__offre-titre {
			font-size: 2.5rem;
		}

		.accueil__offre-lien {
			grid-column: 2;
		}

		/* Cadre en largeur : numéro à gauche, titre et texte à droite */
		.accueil__etape {
			display: grid;
			grid-template-columns: 8rem minmax(0, 1fr);
			column-gap: 2rem;
			align-items: start;
			padding: 2rem 2.5rem 2.5rem;
		}

		.accueil__etape-numero {
			grid-row: span 2;
			font-size: 6rem;
		}

		.accueil__etape-titre {
			margin-top: 0.5rem;
			font-size: 2.25rem;
		}

		.accueil__etape-texte {
			max-width: 36rem;
		}

		/* Étapes épinglées (src/scripts/defilement.ts, effet « etapes-epinglees ») : la classe n'est posée que par le
		   script, sur ordinateur et si les animations sont acceptées. La piste prend toute la largeur de l'écran
		   (html a déjà overflow-x: clip) et commence alignée sur le titre ; GSAP la fait glisser vers la gauche. */
