---
// Page Services et tarifs
// Contenu fourni par Jimmy, pas encore validé par toute l'équipe (point jeudi) : à revérifier.
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Services et tarifs"
  description="Découvrez les offres de Narukla : site vitrine, identité visuelle et maintenance, avec leurs tarifs."
>
  <div class="services">
    <section class="services__intro" aria-labelledby="services-title">
      <h1 id="services-title" class="services__title">Services et tarifs</h1>
      <p class="services__lead">
        Nous sommes une agence web étudiante, formée par cinq étudiants du BUT MMI de l’IUT de Troyes.
        Nous créons des sites vitrines et des identités visuelles, et nous en assurons ensuite la maintenance.
      </p>
    </section>

    <section class="offer" id="site-vitrine" aria-labelledby="offer-vitrine-title">
      <h2 id="offer-vitrine-title" class="offer__title">Site vitrine</h2>
      <p class="offer__price">800 €</p>
      <ul class="offer__features">
        <li class="offer__feature">Jusqu’à 5 pages</li>
        <li class="offer__feature">Site responsive, adapté aux mobiles et aux tablettes</li>
        <li class="offer__feature">SEO de base : titres, balises et fiche Google Business</li>
        <li class="offer__feature">Formulaire de contact</li>
        <li class="offer__feature">Nom de domaine .fr et hébergement la première année</li>
        <li class="offer__feature">3 tours de modifications</li>
      </ul>
      <p class="offer__delay">Livraison en 3 à 4 semaines</p>
      <a class="offer__cta" href="/contact">Demander un devis</a>
    </section>

    <section class="offer" id="identite-visuelle" aria-labelledby="offer-identite-title">
      <h2 id="offer-identite-title" class="offer__title">Identité visuelle</h2>
      <p class="offer__price">De 600 à 1 000 €</p>
      <ul class="offer__features">
        <li class="offer__feature">
          <strong>À partir de 600 €</strong> : logo, couleurs et typographies
        </li>
        <li class="offer__feature">
          <strong>Jusqu’à 1 000 €</strong> : charte graphique complète et déclinaisons
          (cartes de visite, réseaux sociaux, menu, etc.)
        </li>
      </ul>
      <a class="offer__cta" href="/contact">Demander un devis</a>
    </section>

    <section class="offer" id="maintenance" aria-labelledby="offer-maintenance-title">
      <h2 id="offer-maintenance-title" class="offer__title">Maintenance</h2>
      <p class="offer__price">40 €/mois</p>
      <ul class="offer__features">
        <li class="offer__feature">Mises à jour</li>
        <li class="offer__feature">Sauvegardes</li>
        <li class="offer__feature">Petites modifications de contenu (horaires, prix, etc.)</li>
        <li class="offer__feature">Réponse sous 48 h</li>
      </ul>
      <a class="offer__cta" href="/contact">Nous contacter</a>
    </section>

    <section class="process" aria-labelledby="process-title">
      <h2 id="process-title" class="process__title">Comment se passe un projet ?</h2>
      <ol class="process__steps">
        <li class="process__step">
          <h3 class="process__step-title">Premier rendez-vous</h3>
          <p class="process__step-text">Nous prenons le temps de comprendre votre besoin.</p>
        </li>
        <li class="process__step">
          <h3 class="process__step-title">Devis et acompte</h3>
          <p class="process__step-text">Nous vous envoyons un devis, validé avec un acompte de 30 %.</p>
        </li>
        <li class="process__step">
          <h3 class="process__step-title">Maquette</h3>
          <p class="process__step-text">Nous concevons la maquette de votre projet.</p>
        </li>
        <li class="process__step">
          <h3 class="process__step-title">Développement</h3>
          <p class="process__step-text">Nous passons à la réalisation.</p>
        </li>
        <li class="process__step">
          <h3 class="process__step-title">Retours et modifications</h3>
          <p class="process__step-text">Vous nous faites vos retours et nous ajustons.</p>
        </li>
        <li class="process__step">
          <h3 class="process__step-title">Mise en ligne</h3>
          <p class="process__step-text">Nous mettons votre projet en ligne, puis vous réglez le solde.</p>
        </li>
      </ol>
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <h2 id="cta-title" class="cta__title">Un projet en tête ?</h2>
      <p class="cta__text">Parlez-nous de votre projet, nous reviendrons vers vous pour en discuter.</p>
      <a class="cta__link" href="/contact">Contactez-nous</a>
    </section>
  </div>
</Layout>
