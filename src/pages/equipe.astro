---
// Page L'équipe — responsable : Jibril
// Structure en HTML brut (mar. 27). Le CSS arrive avec la maquette (mer. 28).
import Layout from '../layouts/Layout.astro';

// Les 5 associés, par ordre alphabétique (pas de hiérarchie : parts égales).
// Rôles : ceux du prompt d'équipe de Jimmy. Présentations : à recevoir de chacun (avant mer. 28 au soir).
// photo : chemin dans public/ (ex. '/equipe/jibril.webp'), null en attendant la photo commune (lun. 2/11, idée de Noah).
// mail, linkedin, portfolio : facultatifs, seulement pour ceux qui le veulent (idée de Noah), null sinon.
const associes = [
	{
		prenom: 'Jibril',
		role: 'Président, développeur',
		presentation: '[À COMPLÉTER]',
		photo: null,
		mail: null,
		linkedin: null,
		portfolio: null,
	},
	{
		prenom: 'Jimmy',
		role: 'Chef de projet, développeur, commercial',
		presentation: '[À COMPLÉTER]',
		photo: null,
		mail: null,
		linkedin: null,
		portfolio: null,
	},
	{
		prenom: 'Lucas',
		role: 'Gestion de projet, graphiste',
		presentation: '[À COMPLÉTER]',
		photo: null,
		mail: null,
		linkedin: null,
		portfolio: null,
	},
	{
		prenom: 'Noah',
		role: 'Trésorier, graphiste',
		presentation: '[À COMPLÉTER]',
		photo: null,
		mail: null,
		linkedin: null,
		portfolio: null,
	},
	{
		prenom: 'Ouassim',
		role: 'Développeur, marketing',
		presentation: '[À COMPLÉTER]',
		photo: null,
		mail: null,
		linkedin: null,
		portfolio: null,
	},
];
---

<Layout
	title="L'équipe"
	description="Narukla, c'est cinq associés étudiants en BUT MMI à Troyes : développement, graphisme et marketing réunis pour créer votre site."
>
	<section class="equipe__intro">
		<h1>L'équipe</h1>
		<!-- Décision de Jimmy (27/10) : on dit qu'on est étudiants ici, pas en gros sur l'Accueil -->
		<p>
			Narukla est une jeune agence web installée à Troyes. Nous sommes cinq associés, étudiants en
			BUT MMI (Métiers du multimédia et de l'internet) à l'IUT de Troyes : développement, graphisme
			et marketing réunis dans une même équipe.
		</p>
	</section>

	<section class="equipe__associes" aria-labelledby="titre-associes">
		<h2 id="titre-associes">Les associés</h2>
		<ul class="equipe__liste">
			{
				associes.map((associe) => (
					<li>
						<article class="equipe__carte">
							{associe.photo && (
								<img
									class="equipe__photo"
									src={associe.photo}
									alt={`Portrait de ${associe.prenom}`}
									width="400"
									height="400"
									loading="lazy"
								/>
							)}
							<h3 class="equipe__prenom">{associe.prenom}</h3>
							<p class="equipe__role">{associe.role}</p>
							<p class="equipe__presentation">{associe.presentation}</p>
							{(associe.mail || associe.linkedin || associe.portfolio) && (
								<ul class="equipe__liens">
									{associe.mail && (
										<li>
											<a href={`mailto:${associe.mail}`}>Écrire à {associe.prenom}</a>
										</li>
									)}
									{associe.linkedin && (
										<li>
											<a href={associe.linkedin}>LinkedIn de {associe.prenom}</a>
										</li>
									)}
									{associe.portfolio && (
										<li>
											<a href={associe.portfolio}>Portfolio de {associe.prenom}</a>
										</li>
									)}
								</ul>
							)}
						</article>
					</li>
				))
			}
		</ul>
	</section>

	<section class="equipe__approche" aria-labelledby="titre-approche">
		<h2 id="titre-approche">Notre façon de travailler</h2>
		<p>[À COMPLÉTER : notre approche, à valider avec l'équipe]</p>
	</section>

	<section class="equipe__contact" aria-labelledby="titre-contact">
		<h2 id="titre-contact">Un projet en tête ?</h2>
		<p><a href="/contact">Contactez-nous</a></p>
	</section>
</Layout>

<style>
	/* Direction visuelle provisoire (mar. 27, Jimmy), à retoucher par Noah et Lucas.
	   Style seulement : le contenu et la structure de la page sont ceux de Jibril. */
	section {
		padding-block: var(--espace-section);
	}

	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Intro : bande noire comme le haut de l'Accueil */
	.equipe__intro {
		padding-top: clamp(2.5rem, 2rem + 4vw, 5rem);
		background: var(--couleur-noir);
		box-shadow: 0 0 0 100vmax var(--couleur-noir);
		clip-path: inset(0 -100vmax);
		color: var(--couleur-blanc);
	}

	.equipe__intro p {
		max-width: var(--largeur-texte);
		margin: 0;
		font-size: 1.1875rem;
	}

	/* Associés : grille de fiches à traits noirs */
	.equipe__liste {
		display: grid;
		gap: 1.5rem;
	}

	.equipe__carte {
		height: 100%;
		padding: 1.5rem;
		border: var(--trait) solid var(--couleur-noir);
		box-shadow: var(--decalage) var(--decalage) 0 var(--couleur-noir);
	}

	.equipe__photo {
		width: 100%;
		margin-bottom: 1.25rem;
		aspect-ratio: 1;
		object-fit: cover;
		filter: grayscale(1);
	}

	.equipe__prenom {
		margin: 0 0 0.5rem;
		font-size: clamp(2.25rem, 1.75rem + 2vw, 3rem);
	}

	.equipe__role {
		display: inline-block;
		padding: 0.15rem 0.6rem;
		background: var(--couleur-violet);
		color: var(--couleur-blanc);
		font-weight: 800;
		font-size: 0.875rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.equipe__presentation {
		margin: 0;
	}

	.equipe__liens {
		margin-top: 1rem;
		font-weight: 800;
	}

	/* Approche : bande bleue */
	.equipe__approche {
		background: var(--couleur-bleu);
		box-shadow: 0 0 0 100vmax var(--couleur-bleu);
		clip-path: inset(0 -100vmax);
		color: var(--couleur-blanc);
	}

	.equipe__approche p {
		max-width: var(--largeur-texte);
		font-size: 1.1875rem;
	}

	/* Contact : bande violette, lien en bouton */
	.equipe__contact {
		background: var(--couleur-violet);
		box-shadow: 0 0 0 100vmax var(--couleur-violet);
		clip-path: inset(0 -100vmax);
		color: var(--couleur-blanc);
	}

	.equipe__contact h2 {
		font-size: var(--taille-h1);
	}

	.equipe__contact a {
		display: inline-block;
		margin-top: 1rem;
		padding: 0.9rem 1.6rem 0.8rem;
		border: var(--trait) solid var(--couleur-blanc);
		background: var(--couleur-blanc);
		color: var(--couleur-noir);
		box-shadow: var(--decalage) var(--decalage) 0 var(--couleur-noir);
		font-family: var(--police-titre);
		font-size: 1.25rem;
		text-transform: uppercase;
		text-decoration: none;
	}

	@media (min-width: 48rem) {
		.equipe__liste {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.equipe__liste {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
