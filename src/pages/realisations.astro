---
// Page Réalisations
// Pas encore de clients : on montre nos meilleurs projets de cours et perso, présentés comme des projets de l'équipe.
// Duplique le bloc <article class="project"> pour chaque projet. Les "[À compléter]" sont à remplacer.
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Réalisations"
  description="Découvrez les projets de l’équipe Narukla, réalisés en cours ou à titre personnel."
>
  <div class="realisations">
    <section class="realisations__intro" aria-labelledby="realisations-title">
      <h1 id="realisations-title" class="realisations__title">Réalisations</h1>
      <p class="realisations__lead">
        Voici les projets de l’équipe, réalisés en cours ou à titre personnel.
      </p>
    </section>

    <section class="projects" aria-labelledby="projects-title">
      <h2 id="projects-title" class="projects__title">Nos projets</h2>

      <article class="project">
        <h3 class="project__title">[À compléter : nom du projet 1]</h3>
        <p class="project__type">[À compléter : type, ex. site web, identité visuelle]</p>
        <p class="project__description">[À compléter : description courte du projet.]</p>
        <dl class="project__meta">
          <dt>Rôle</dt>
          <dd>[À compléter : qui a fait quoi]</dd>
          <dt>Outils</dt>
          <dd>[À compléter : ex. Astro, Figma]</dd>
        </dl>
        <a class="project__link" href="#">Voir le projet</a>
      </article>

      <article class="project">
        <h3 class="project__title">[À compléter : nom du projet 2]</h3>
        <p class="project__type">[À compléter : type]</p>
        <p class="project__description">[À compléter : description courte du projet.]</p>
        <dl class="project__meta">
          <dt>Rôle</dt>
          <dd>[À compléter]</dd>
          <dt>Outils</dt>
          <dd>[À compléter]</dd>
        </dl>
        <a class="project__link" href="#">Voir le projet</a>
      </article>

      <article class="project">
        <h3 class="project__title">[À compléter : nom du projet 3]</h3>
        <p class="project__type">[À compléter : type]</p>
        <p class="project__description">[À compléter : description courte du projet.]</p>
        <dl class="project__meta">
          <dt>Rôle</dt>
          <dd>[À compléter]</dd>
          <dt>Outils</dt>
          <dd>[À compléter]</dd>
        </dl>
        <a class="project__link" href="#">Voir le projet</a>
      </article>

      <!-- À ajouter dès que c'est terminé : le projet kebab -->
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <h2 id="cta-title" class="cta__title">Envie de travailler avec nous ?</h2>
      <p class="cta__text">Dites-nous ce dont vous avez besoin, on en discute ensemble.</p>
      <a class="cta__link" href="/contact">Contactez-nous</a>
    </section>
  </div>
</Layout>

<style>
  /* Direction visuelle provisoire (mar. 27, Jimmy), à retoucher par Noah et Lucas.
     Style seulement : le contenu et la structure de la page sont ceux d'Ouassim. */

  /* Intro : bande noire */
  .realisations__intro {
    padding-block: clamp(2.5rem, 2rem + 4vw, 5rem) var(--espace-section);
    background: var(--couleur-noir);
    box-shadow: 0 0 0 100vmax var(--couleur-noir);
    clip-path: inset(0 -100vmax);
    color: var(--couleur-blanc);
  }

  .realisations__lead {
    max-width: var(--largeur-texte);
    margin: 0;
    font-size: 1.1875rem;
  }

  /* Projets : lignes numérotées séparées par des traits */
  .projects {
    padding-block: var(--espace-section);
    counter-reset: projet;
  }

  .project {
    counter-increment: projet;
    display: grid;
    gap: 0.5rem 3rem;
    padding-block: 2.5rem;
    border-top: var(--trait) solid var(--couleur-noir);
  }

  .project:last-of-type {
    border-bottom: var(--trait) solid var(--couleur-noir);
  }

  .project::before {
    content: counter(projet, decimal-leading-zero);
    font-family: var(--police-titre);
    font-size: 4rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--couleur-noir);
  }

  .project__title {
    margin: 0;
  }

  .project__type {
    justify-self: start;
    margin: 0;
    padding: 0.15rem 0.6rem;
    background: var(--couleur-violet);
    color: var(--couleur-blanc);
    font-weight: 800;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project__description {
    margin: 0.5rem 0 0;
    max-width: var(--largeur-texte);
  }

  .project__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    margin: 0.5rem 0 0;
  }

  .project__meta dt {
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .project__meta dd {
    margin: 0;
  }

  .project__link {
    justify-self: start;
    margin-top: 0.75rem;
    font-weight: 800;
  }

  /* Appel final : bande violette */
  .cta {
    padding-block: var(--espace-section);
    background: var(--couleur-violet);
    box-shadow: 0 0 0 100vmax var(--couleur-violet);
    clip-path: inset(0 -100vmax);
    color: var(--couleur-blanc);
  }

  .cta__title {
    font-size: var(--taille-h1);
  }

  .cta__text {
    font-size: 1.1875rem;
  }

  .cta__link {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.9rem 1.6rem 0.8rem;
    border: var(--trait) solid var(--couleur-blanc);
    background: var(--couleur-blanc);
    color: var(--couleur-noir);
    box-shadow: var(--decalage) var(--decalage) 0 var(--couleur-noir);
    font-family: var(--police-titre);
    font-size: 1.25rem;
    text-transform: uppercase;
    text-decoration: none;
  }

  @media (min-width: 64rem) {
    /* Numéro à gauche, projet à droite */
    .project {
      grid-template-columns: 8rem 1fr;
    }

    .project::before {
      grid-row: 1 / span 6;
    }

    .project > * {
      grid-column: 2;
    }
  }
</style>
