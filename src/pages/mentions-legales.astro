---
// Page Mentions légales — responsable : Jimmy
// Structure en HTML brut (mar. 27). Le CSS arrive avec la maquette (mer. 28).
// Ce qui n'est pas encore décidé vaut null : la ligne ne s'affiche pas (jamais de [À COMPLÉTER] en ligne).
import Layout from '../layouts/Layout.astro';
import Intro from '../components/Intro.astro';
import { coordonnees, lienTelephone } from '../config/coordonnees';

// Société en cours de constitution (Kbis attendu mi-novembre) : pas encore de SIREN, de RCS ni de TVA.
// Dès l'immatriculation : ajouter SIREN, RCS et TVA, et retirer « en cours de constitution ».
const editeur = {
	forme: 'société par actions simplifiée (SAS) en cours de constitution',
	// Capital voté par les 4 sur Discord le 5/11 : 100 € chacun (statuts, art. 7). À publier seulement une fois les
	// statuts signés et le capital déposé à la banque (sinon on annonce un capital qui n'existe pas encore).
	capital: '400 €' as string | null,
	// Siège chez Jibril (validé le 5/11). L'adresse est PUBLIQUE (mentions, Kbis, annuaires) : choix à confirmer
	// entre son adresse personnelle et une domiciliation avant de la remplir. null = la ligne ne s'affiche pas.
	siege: null as string | null,
	president: 'Jibril Filali',
	// Depuis src/config/coordonnees.ts (un seul endroit pour tout le site)
	mail: coordonnees.mail,
	telephone: coordonnees.telephone,
};

// Sommaire : mêmes ids et même ordre que les sections ci-dessous
const sommaire = [
	{ id: 'editeur', titre: 'Éditeur du site' },
	{ id: 'hebergeur', titre: 'Hébergeur' },
	{ id: 'propriete', titre: 'Propriété intellectuelle' },
	{ id: 'donnees', titre: 'Données personnelles' },
	{ id: 'cookies', titre: 'Cookies' },
	{ id: 'responsabilite', titre: 'Responsabilité' },
];

const hebergeur = {
	// Adresse vérifiée le 31/10/2026 (cloudflare.com/privacypolicy).
	nom: 'Cloudflare, Inc.',
	adresse: '101 Townsend St., San Francisco, CA 94107, États-Unis',
	// Téléphone non vérifié : null tant que l'avocate n'a pas tranché (on n'en invente pas)
	telephone: null as string | null,
	site: 'https://www.cloudflare.com',
};

// Hébergeur jusqu'au 1/11/2026 : Netlify Forms garde les messages reçus avant cette date (on les garde, décision du 2/11).
// Adresse vérifiée le 2/11/2026 (netlify.com/privacy). Retirer ce paragraphe une fois ces messages supprimés.
const ancienHebergeur = {
	nom: 'Netlify, Inc.',
	adresse: '101 2nd Street, San Francisco, CA 94105, États-Unis',
};
---

<Layout
	title="Mentions légales"
	description="Mentions légales du site de Narukla : éditeur, hébergeur, propriété intellectuelle et données personnelles."
>
	<!-- Mise en forme d'après la maquette Figma de Noah (Mentions légales Desktop 1440), 29/10.
	     Les textes restent ceux du code (plus à jour que la maquette). -->
	<Intro etiquette="Informations légales" titre="Mentions légales" />

	<div class="mentions">
		<nav class="mentions__sommaire" aria-labelledby="titre-sommaire">
			<h2 id="titre-sommaire" class="mentions__sommaire-titre">Sommaire</h2>
			<ol class="mentions__sommaire-liste">
				{
					sommaire.map((entree, i) => (
						<li>
							<a href={`#${entree.id}`}>
								<span class="mentions__numero">{String(i + 1).padStart(2, '0')}</span> {entree.titre}
							</a>
						</li>
					))
				}
			</ol>
		</nav>

		<article class="mentions__article">

		<section class="mentions__section" id="editeur" aria-labelledby="titre-editeur">
			<h2 id="titre-editeur" class="mentions__titre"><span class="mentions__numero">01</span> Éditeur du site</h2>
			<p>
				Ce site est édité par Narukla, {editeur.forme}{editeur.capital && `, au capital de ${editeur.capital}`}. Son
				immatriculation au registre du commerce et des sociétés est en cours : le numéro SIREN sera
				indiqué ici dès sa délivrance.
			</p>
			<ul>
				{editeur.siege && <li>Siège social : {editeur.siege}</li>}
				<li>E-mail : <a href={`mailto:${editeur.mail}`}>{editeur.mail}</a></li>
				<li>
					Téléphone :{' '}
					<a href={lienTelephone(editeur.telephone)}>{editeur.telephone}</a>
				</li>
				<li>Président et directeur de la publication : {editeur.president}</li>
			</ul>
		</section>

		<section class="mentions__section" id="hebergeur" aria-labelledby="titre-hebergeur">
			<h2 id="titre-hebergeur" class="mentions__titre"><span class="mentions__numero">02</span> Hébergeur</h2>
			<p>
				Le site est hébergé par {hebergeur.nom}, {hebergeur.adresse}{hebergeur.telephone && `, téléphone : ${hebergeur.telephone}`}{' '}
				(<a href={hebergeur.site} rel="noopener">{hebergeur.site}</a>).
			</p>
		</section>

		<section class="mentions__section" id="propriete" aria-labelledby="titre-propriete">
			<h2 id="titre-propriete" class="mentions__titre"><span class="mentions__numero">03</span> Propriété intellectuelle</h2>
			<p>
				Les contenus de ce site (textes, images, logo, graphismes, code) appartiennent à Narukla,
				sauf mention contraire. Toute reproduction, totale ou partielle, sans autorisation écrite
				préalable est interdite.
			</p>
			<p>
				Les projets présentés dans la rubrique Réalisations restent la propriété de leurs auteurs ou
				de leurs clients et sont affichés avec leur accord.
			</p>
		</section>

		<section class="mentions__section" id="donnees" aria-labelledby="titre-donnees">
			<h2 id="titre-donnees" class="mentions__titre"><span class="mentions__numero">04</span> Données personnelles</h2>
			<p>
				Les informations envoyées par le formulaire de contact (nom, entreprise, e-mail, téléphone,
				message) servent uniquement à répondre à votre demande et à vous établir un devis. Elles ne
				sont ni vendues ni cédées. Elles ne sont accessibles qu'aux associés de Narukla et à nos
				prestataires techniques, qui les traitent pour notre compte.
			</p>
			<!-- Ajouté avec la notification Discord (functions/api/contact.js) :
			     le salon Discord doit rester privé, réservé aux associés -->
			<p>
				Pour que l'équipe soit prévenue rapidement, une copie de votre demande (nom, entreprise,
				e-mail, téléphone, besoin et message) est transmise dans un espace de discussion privé de
				l'équipe, hébergé par Discord Inc.
			</p>
			<!-- À relire par l'avocate. Garanties des transferts à vérifier dans les accords de traitement des données (DPA) de Cloudflare et de Discord -->
			<p>
				Les messages du formulaire transitent par {hebergeur.nom} et sont conservés chez Discord Inc., deux
				sociétés situées aux États-Unis. Il s'agit donc de transferts de données hors de l'Union
				européenne, encadrés par les garanties prévues par le RGPD pour ce type de transfert.
			</p>
			<!-- Ajouté avec l'espace de gestion des associés (admin.narukla.fr, repo admin) : à fusionner SEULEMENT le jour de sa mise en ligne.
			     À relire par l'avocate : garanties des transferts dans le DPA de Resend (https://resend.com/legal/dpa) ;
			     Resend indique stocker les données aux États-Unis (https://resend.com/security/gdpr) -->
			<p>
				Votre demande est aussi enregistrée chez {hebergeur.nom} dans notre espace de gestion privé,
				réservé aux associés. Juste après l'envoi du formulaire, vous recevez un e-mail qui confirme
				la bonne réception de votre demande, et une copie de votre demande arrive dans la boîte e-mail
				de l'agence. Ces e-mails, comme nos réponses envoyées depuis l'espace de gestion, partent
				par l'intermédiaire de Resend (Plus Five Five, Inc., États-Unis), notre prestataire d'envoi
				d'e-mails : il reçoit votre adresse e-mail et le contenu de ces messages. Il s'agit là aussi
				d'un transfert de données hors de l'Union européenne, encadré par les garanties prévues par le RGPD.
			</p>
			<!-- Durée de conservation à valider en réunion -->
			<p>
				Vos données sont conservées au maximum 3 ans après notre dernier échange. Le responsable du
				traitement est Narukla.
			</p>
			<!-- Validé avec l'avocate (2/11). Les messages restent dans Netlify Forms (décision de Jibril, 2/11) : à retirer seulement s'ils sont supprimés un jour -->
			<p>
				Les messages envoyés avant le 1er novembre 2026 ont été reçus par l'intermédiaire
				de {`${ancienHebergeur.nom} (${ancienHebergeur.adresse})`}, ancien hébergeur du site, situé lui
				aussi hors de l'Union européenne. Il les conserve pour notre compte, dans la même limite de 3 ans.
			</p>
			<p>
				Conformément au Règlement général sur la protection des données (RGPD) et à la loi
				Informatique et Libertés, vous pouvez accéder à vos données, les rectifier, les supprimer ou
				vous opposer à leur traitement en nous écrivant à {editeur.mail}. Vous pouvez aussi adresser
				une réclamation à la CNIL (<a href="https://www.cnil.fr" rel="noopener">cnil.fr</a>).
			</p>
		</section>

		<section class="mentions__section" id="cookies" aria-labelledby="titre-cookies">
			<h2 id="titre-cookies" class="mentions__titre"><span class="mentions__numero">05</span> Cookies</h2>
			<p>
				Ce site ne dépose aucun cookie et n'utilise aucun traceur. Nous consultons seulement les
				statistiques globales de fréquentation que notre hébergeur Cloudflare établit à partir des pages
				servies (nombre de pages vues, pays d'origine), sans pouvoir identifier les visiteurs. Si cela
				change, un bandeau vous demandera votre accord avant tout dépôt de cookie.
			</p>
		</section>

		<section class="mentions__section" id="responsabilite" aria-labelledby="titre-responsabilite">
			<h2 id="titre-responsabilite" class="mentions__titre"><span class="mentions__numero">06</span> Responsabilité</h2>
			<p>
				Narukla veille à ce que les informations de ce site soient exactes et à jour, sans pouvoir
				garantir l'absence d'erreur. Les liens vers des sites externes n'engagent pas sa
				responsabilité.
			</p>
		</section>
		</article>
	</div>
</Layout>

<style>
	/* Mentions légales, d'après la maquette Figma (Desktop 1440) ; mobile : sommaire au-dessus du texte */
	.mentions {
		display: grid;
		gap: 2.5rem;
		padding-block: 4.25rem;
		font-family: var(--police-corps);
	}

	/* Sommaire encadré, ombre violette */
	.mentions__sommaire {
		align-self: start;
		padding: 1.375rem 1.5rem 1.5rem;
		background: var(--couleur-blanc);
		border: 3px solid var(--couleur-noir);
		box-shadow: 6px 6px 0 var(--couleur-violet);
	}

	.mentions__sommaire-titre {
		margin: 0 0 0.375rem;
		color: var(--couleur-violet);
		font-family: var(--police-titre);
		font-size: 1.375rem;
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.mentions__sommaire-liste {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.mentions__sommaire-liste a {
		display: block;
		padding-block: 0.6rem;
		color: var(--couleur-noir);
		font-size: 1.0625rem;
		font-weight: 700;
		line-height: 1.4;
		text-decoration: none;
	}

	.mentions__sommaire-liste a:hover {
		text-decoration: underline;
	}

	.mentions__sommaire .mentions__numero {
		color: var(--couleur-noir);
		margin-right: 0.5rem;
	}

	/* Sections séparées par un filet noir */
	.mentions__article :global(.mentions__section) {
		padding-block: 2rem;
		border-bottom: 3px solid var(--couleur-noir);
		/* le titre ne passe pas sous le haut de l'écran quand on clique dans le sommaire */
		scroll-margin-top: 1.5rem;
	}

	.mentions__article :global(.mentions__section:first-child) {
		padding-top: 0;
	}

	.mentions__titre {
		margin: 0 0 0.875rem;
		font-family: var(--police-titre);
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 400;
		line-height: 1.05;
		text-transform: uppercase;
	}

	.mentions__titre .mentions__numero {
		color: var(--couleur-violet);
	}

	.mentions__article p,
	.mentions__article li {
		font-size: 1.0625rem;
		line-height: 1.65;
	}

	.mentions__article p {
		margin: 0 0 0.875rem;
	}

	/* Liste de l'éditeur : tirets comme la maquette */
	.mentions__article ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.mentions__article li::before {
		content: '— ';
	}

	.mentions__article a {
		color: var(--couleur-noir);
		font-weight: 700;
	}

	.mentions a:focus-visible {
		outline: 3px solid var(--couleur-violet);
		outline-offset: 3px;
	}

	/* Desktop : sommaire à gauche (qui reste visible en défilant), texte à droite */
	@media (min-width: 64rem) {
		.mentions {
			grid-template-columns: 18.75rem minmax(0, 47.5rem);
			gap: 5rem;
			padding-block: 7.5rem;
		}

		.mentions__sommaire {
			position: sticky;
			top: 1.5rem;
		}
	}
</style>
