---
// Layout commun à toutes les pages : <head>, en-tête, pied de page.
// Chaque page passe son titre et sa description (SEO) en props.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	// true pour les pages à ne pas afficher dans Google (ex. /merci)
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// Adresses absolues (domaine défini dans astro.config.mjs → site)
const titreComplet = `${title} | Narukla`;
const adresseCanonique = new URL(Astro.url.pathname, Astro.site);
const imagePartage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Police des titres et du menu chargée en priorité : sinon l'en-tête change de hauteur quand elle arrive
		     et toute la page saute (décalage de 0,449 mesuré par PageSpeed sur ordinateur, 31/10) -->
		<link rel="preload" href="/fonts/anton-400.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{titreComplet}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={adresseCanonique} />
		<link rel="sitemap" href="/sitemap.xml" />

		<!-- Aperçu quand le lien est partagé (WhatsApp, Instagram, LinkedIn, Discord…) -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content="Narukla" />
		<meta property="og:title" content={titreComplet} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={adresseCanonique} />
		<meta property="og:image" content={imagePartage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Logo Narukla, agence web à Troyes" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<a class="skip-link" href="#contenu">Aller au contenu</a>
		<Header />
		<main id="contenu">
			<slot />
		</main>
		<Footer />
	</body>
</html>
