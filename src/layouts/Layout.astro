---
// Layout commun à toutes les pages : <head>, en-tête, pied de page.
// Chaque page passe son titre et sa description (SEO) en props.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	// true pour les pages à ne pas afficher dans Google (ex. /merci)
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Narukla</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
	</head>
	<body>
		<a class="skip-link" href="#contenu">Aller au contenu</a>
		<Header />
		<main id="contenu">
			<slot />
		</main>
		<Footer />
	</body>
</html>
