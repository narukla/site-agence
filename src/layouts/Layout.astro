---
// Layout commun à toutes les pages : <head>, en-tête, pied de page.
// Chaque page passe son titre et sa description (SEO) en props.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Effets from '../components/Effets.astro';
import Allumage from '../components/Allumage.astro';
import { effetsActifs } from '../config/effets';
import { coordonnees } from '../config/coordonnees';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	// true pour les pages à ne pas afficher dans Google (ex. /merci)
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// Adresses absolues (domaine défini dans astro.config.mjs → site)
const titreComplet = `${title} | Narukla`;
const adresseCanonique = new URL(Astro.url.pathname, Astro.site);
const imagePartage = new URL('/og-image.png', Astro.site);

// Fiche de l'agence lue par Google (données structurées schema.org) : nom, contact, ville, offres.
// Uniquement des informations déjà affichées sur le site (rien d'inventé : ni avis, ni note, ni adresse de rue).
// Les prix reprennent ceux de la page Services : les changer aux deux endroits.
const ficheAgence = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Narukla',
	description: 'Agence web à Troyes : sites vitrines, identités visuelles et maintenance pour les commerces, artisans et indépendants.',
	url: Astro.site?.toString(),
	logo: new URL('/logo/narukla-600.webp', Astro.site).toString(),
	image: imagePartage.toString(),
	email: coordonnees.mail,
	telephone: `+33${coordonnees.telephone.replace(/\s/g, '').slice(1)}`,
	address: { '@type': 'PostalAddress', addressLocality: 'Troyes', postalCode: '10000', addressCountry: 'FR' },
	areaServed: { '@type': 'AdministrativeArea', name: 'Aube' },
	makesOffer: [
		{ '@type': 'Offer', name: 'Site vitrine', priceSpecification: { '@type': 'PriceSpecification', minPrice: '800', priceCurrency: 'EUR' } },
		{ '@type': 'Offer', name: 'Identité visuelle', priceSpecification: { '@type': 'PriceSpecification', minPrice: '600', maxPrice: '1000', priceCurrency: 'EUR' } },
		{ '@type': 'Offer', name: 'Maintenance', priceSpecification: { '@type': 'UnitPriceSpecification', minPrice: '40', priceCurrency: 'EUR', unitText: 'mois' } },
	],
};
---

<!doctype html>
<html lang="fr" class={effetsActifs.map((nom) => `avec-${nom}`).join(' ')}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Police des titres et du menu chargée en priorité : sinon l'en-tête change de hauteur quand elle arrive
		     et toute la page saute (décalage de 0,449 mesuré par PageSpeed sur ordinateur, 31/10) -->
		<link rel="preload" href="/fonts/anton-400.woff2" as="font" type="font/woff2" crossorigin />
		<!-- ?v=2 : nouvelle adresse pour que les navigateurs oublient l'ancienne icône d'Astro gardée en cache (même nom
		     de fichier jusqu'au 31/10). Changer le numéro à chaque nouveau favicon. -->
		<link rel="icon" href="/favicon.ico?v=2" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
		<meta name="generator" content={Astro.generator} />
		<title>{titreComplet}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<!-- Pas d'adresse canonique sur une page exclue de Google : sur la 404, elle pointait vers /404/ quelle que soit
		     l'adresse demandée, et « noindex » + « canonical » envoient deux signaux contradictoires -->
		{!noindex && <link rel="canonical" href={adresseCanonique} />}
		<!-- Couleur de la barre du navigateur sur mobile : le noir de l'en-tête -->
		<meta name="theme-color" content="#000000" />
		<!-- Fiche de l'agence pour Google : un bloc de données, pas un script exécuté (la CSP ne le concerne pas) -->
		{!noindex && <script type="application/ld+json" set:html={JSON.stringify(ficheAgence)} />}
		<link rel="sitemap" href="/sitemap.xml" />

		<!-- Aperçu quand le lien est partagé (WhatsApp, Instagram, LinkedIn, Discord…) -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content="Narukla" />
		<meta property="og:title" content={titreComplet} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={adresseCanonique} />
		<meta property="og:image" content={imagePartage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Logo Narukla, agence web à Troyes" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<a class="skip-link" href="#contenu">Aller au contenu</a>
		<!-- Écran de chargement de la maquette de Jimmy (2/11) : ordinateur, une fois par visite -->
		<Allumage />
		<Header />
		<main id="contenu">
			<slot />
		</main>
		<Footer />
		<Effets />
	</body>
</html>
